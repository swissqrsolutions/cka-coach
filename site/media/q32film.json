"questions": [
{
"id": "Q1",
"q": "Why do you check the CPU request first?",
"opts": [
[
"70% is a share of the CPU request",
true,
"Correct. No request, no percentage."
],
[
"The request sets the maximum pods",
false,
"The maximum comes from --max."
],
[
"kubectl refuses without it",
false,
"The percentage is simply calculated from the request."
]
],
"t": 61.17
},
{
